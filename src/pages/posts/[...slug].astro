---
import { render } from 'astro:content';
import PostLayout from '~/layouts/PostLayout.astro';
import {
  getPosts,
  getUnlistedPosts,
  postSlug,
  sortPostsByFilename,
  type Post,
} from '~/utils/posts';

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

export async function getStaticPaths() {
  let paths = [];

  const posts = await getPosts();
  // Unlisted posts are excluded from all listings but still need a
  // generated URL so they're accessible by direct link.
  const unlistedPosts = await getUnlistedPosts();
  // Prev/next navigation only spans listed posts (unlisted posts are
  // invisible to readers browsing the site, so linking to them from
  // prev/next would be confusing).
  const filenameOrder = sortPostsByFilename(posts);

  paths.push(
    ...posts.map((post) => {
      const i = filenameOrder.findIndex((p) => p.id === post.id);
      return {
        params: { slug: postSlug(post) },
        props: {
          post,
          prev: filenameOrder[i + 1],
          next: filenameOrder[i - 1],
        },
      };
    }),
  );

  // Unlisted posts: generate routes but no prev/next neighbours.
  paths.push(
    ...unlistedPosts.map((post) => ({
      params: { slug: postSlug(post) },
      props: { post, prev: undefined, next: undefined },
    })),
  );

  return paths;
}

const { post, prev, next } = Astro.props as Props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} prev={prev} next={next}>
  <Content />
</PostLayout>
